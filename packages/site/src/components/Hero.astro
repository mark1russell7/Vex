---
/**
 * The hero of the home page: the hero of Starlight with the install command, and the live Vex scene beside it.
 * The site config sets this component as the override of the Starlight hero, so only the home page uses it.
 */
import Default from "@astrojs/starlight/components/Hero.astro";
import CopyInstall from "./CopyInstall.tsx";
import LiveHero from "./LiveHero.tsx";
---

<div class="vx-hero">
  <div>
    <Default />
    <CopyInstall client:idle />
  </div>
  <LiveHero client:load />
</div>
