---
/**
 * The showcase of the home page: a card with a small picture for each interactive page. The pictures are static SVG,
 * so the showcase adds no script to the page. Each picture is decoration, and the link text names the page.
 */
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const cards = [
  { href: "lab/", art: "lab", title: "The Lab", text: "Write a chain and see its result at each record: boxes, a Life grid, a tree or rows." },
  { href: "gallery/life/", art: "life", title: "The Game of Life", text: "The rule of Conway is one Vex expression. It evaluates at each cell in each generation." },
  { href: "learn/sheets/", art: "sheet", title: "Sheets and cycles", text: "Cells refer to cells. A cycle gives the error value #CYCLE!, and the other cells stay correct." },
  { href: "learn/axes/", art: "tree", title: "Axes as relations", text: "An axis goes from the focus to a list of keys. A tree has children, ancestors and descendants." },
  { href: "errors/ref/", art: "rail", title: "Why none?", text: "Each error value has a code and a trace. A live example shows where each code starts." },
  { href: "gallery/laws/", art: "laws", title: "The law arena", text: "fast-check tests the laws of each domain in your browser. It finds a false claim and makes it small." },
] as const;
const glider = [[1, 2], [2, 3], [3, 1], [3, 2], [3, 3], [4, 8], [4, 9], [4, 10]];
const next = [[2, 1], [2, 3], [3, 2], [3, 3], [4, 2], [3, 9], [4, 9], [5, 9]];
---

<ul class="vx-showcase not-content">
  {
    cards.map((c) => (
      <li>
        <a class="vx-show" href={`${base}${c.href}`}>
          <svg class="vx-show-art" viewBox="0 0 240 140" aria-hidden="true" focusable="false">
            {c.art === "lab" && (
              <g>
                <rect x="12" y="16" width="104" height="108" rx="6" fill="var(--color-surface-sunken)" stroke="var(--color-rule-strong)" />
                <rect x="22" y="30" width="22" height="6" rx="3" fill="var(--color-accent)" />
                <rect x="48" y="30" width="26" height="6" rx="3" fill="var(--color-ink-secondary)" />
                <rect x="78" y="30" width="28" height="6" rx="3" class="vx-art-str" />
                <rect x="30" y="46" width="34" height="6" rx="3" fill="var(--color-ink-secondary)" />
                <rect x="68" y="46" width="30" height="6" rx="3" fill="var(--color-accent)" />
                <rect x="30" y="62" width="14" height="6" rx="3" class="vx-art-kw" />
                <rect x="48" y="62" width="48" height="6" rx="3" class="vx-art-str" />
                <rect x="30" y="78" width="26" height="6" rx="3" fill="var(--color-ink-secondary)" />
                <rect x="22" y="94" width="8" height="12" rx="1" fill="var(--color-accent)" class="vx-art-caret" />
                <rect x="132" y="30" width="44" height="36" rx="3" fill="var(--color-accent-wash)" stroke="var(--color-accent)" stroke-width="2" />
                <rect x="176" y="76" width="48" height="30" rx="3" fill="var(--color-accent-wash)" stroke="var(--color-ink)" stroke-width="1.5" />
                <rect x="140" y="92" width="30" height="30" rx="3" fill="var(--color-mark-wash)" stroke="var(--color-mark)" stroke-width="2" />
                <text x="176" y="25" class="vx-art-chip" text-anchor="end">5</text>
                <text x="224" y="71" class="vx-art-chip" text-anchor="end">7.28</text>
                <text x="170" y="87" class="vx-art-chip vx-art-bad" text-anchor="end">#REF!</text>
              </g>
            )}
            {c.art === "life" && (
              <g>
                {Array.from({ length: 7 }, (_r, i) =>
                  Array.from({ length: 12 }, (_c, j) => <rect x={24 + j * 16} y={14 + i * 16} width="14" height="14" rx="2" fill="var(--color-surface)" stroke="var(--color-rule)" />),
                )}
                {next.map(([i, j]) => <rect x={24 + (j ?? 0) * 16 + 1} y={14 + (i ?? 0) * 16 + 1} width="12" height="12" rx="2" fill="none" stroke="var(--color-accent)" stroke-dasharray="2 2" />)}
                {glider.map(([i, j]) => <rect class="vx-art-cell" x={24 + (j ?? 0) * 16} y={14 + (i ?? 0) * 16} width="14" height="14" rx="2" fill="var(--color-accent)" />)}
              </g>
            )}
            {c.art === "sheet" && (
              <g font-family="var(--font-mono)" font-size="11">
                {["", "A", "B", "C"].map((h, j) => (
                  <g>
                    <rect x={20 + j * 52} y="14" width="52" height="22" fill="var(--color-surface-sunken)" stroke="var(--color-rule)" />
                    <text x={46 + j * 52} y="29" text-anchor="middle" fill="var(--color-ink-muted)">{h}</text>
                  </g>
                ))}
                {[1, 2, 3, 4].map((r, i) => (
                  <g>
                    <rect x="20" y={36 + i * 22} width="52" height="22" fill="var(--color-surface-sunken)" stroke="var(--color-rule)" />
                    <text x="46" y={51 + i * 22} text-anchor="middle" fill="var(--color-ink-muted)">{r}</text>
                    {[0, 1, 2].map((j) => <rect x={72 + j * 52} y={36 + i * 22} width="52" height="22" fill="var(--color-surface)" stroke="var(--color-rule)" />)}
                  </g>
                ))}
                <text x="98" y="51" text-anchor="middle" fill="var(--color-ink)">4</text>
                <text x="150" y="51" text-anchor="middle" fill="var(--color-ink)">8</text>
                <text x="202" y="51" text-anchor="middle" fill="var(--color-ink)">12</text>
                <text x="98" y="73" text-anchor="middle" fill="var(--color-ink)">3</text>
                <text x="150" y="73" text-anchor="middle" fill="var(--color-accent)" font-weight="700">7</text>
                <rect x="73" y="81" width="102" height="20" fill="var(--color-mark-wash)" />
                <text x="98" y="95" text-anchor="middle" fill="var(--color-mark)" font-weight="700" font-size="9.5">#CYCLE!</text>
                <text x="150" y="95" text-anchor="middle" fill="var(--color-mark)" font-weight="700" font-size="9.5">#CYCLE!</text>
                <path d="M 112 84 C 124 74, 136 74, 140 82" fill="none" stroke="var(--color-mark)" stroke-width="1.5" marker-end="url(#vx-art-head)" />
                <path d="M 136 100 C 124 110, 112 110, 108 102" fill="none" stroke="var(--color-mark)" stroke-width="1.5" marker-end="url(#vx-art-head)" />
                <text x="202" y="95" text-anchor="middle" fill="var(--color-ink)">2</text>
                <text x="98" y="117" text-anchor="middle" fill="var(--color-ink)">9</text>
              </g>
            )}
            {c.art === "tree" && (
              <g>
                <path d="M120 30 L70 70 M120 30 L170 70 M70 70 L36 110 M70 70 L84 110 M70 70 L132 110 M170 70 L196 110" stroke="var(--color-rule-strong)" stroke-width="1.5" fill="none" />
                <path d="M70 70 L36 110 M70 70 L84 110 M70 70 L132 110" stroke="var(--color-accent)" stroke-width="2.5" fill="none" stroke-dasharray="5 4" class="vx-art-flow" />
                {[[120, 30, 0], [70, 70, 2], [170, 70, 0], [36, 110, 1], [84, 110, 1], [132, 110, 1], [196, 110, 0]].map(([x, y, k]) => (
                  <rect
                    x={(x ?? 0) - 18}
                    y={(y ?? 0) - 11}
                    width="36"
                    height="22"
                    rx="5"
                    fill={k === 2 ? "var(--color-accent)" : k === 1 ? "var(--color-accent-wash)" : "var(--color-surface)"}
                    stroke={k === 0 ? "var(--color-rule-strong)" : "var(--color-accent)"}
                    stroke-width="1.5"
                  />
                ))}
              </g>
            )}
            {c.art === "rail" && (
              <g font-family="var(--font-mono)" font-size="10.5">
                <line x1="30" y1="62" x2="210" y2="62" stroke="var(--color-rule-strong)" stroke-width="2" />
                {["from", "offset", "add", "min"].map((t, i) => (
                  <g>
                    <circle cx={30 + i * 60} cy="62" r="9" fill={i < 1 ? "var(--color-accent)" : "var(--color-mark)"} />
                    <text x={30 + i * 60} y="88" text-anchor="middle" fill="var(--color-ink-secondary)">{t}</text>
                  </g>
                ))}
                <rect x="58" y="22" width="64" height="22" rx="11" fill="var(--color-mark-wash)" stroke="var(--color-mark)" />
                <text x="90" y="37" text-anchor="middle" fill="var(--color-mark)" font-weight="700">#REF!</text>
                <text x="120" y="118" text-anchor="middle" fill="var(--color-ink-muted)">row -1 is outside the space</text>
              </g>
            )}
            {c.art === "laws" && (
              <g font-family="var(--font-mono)" font-size="11">
                {[180, 132, 96, 60, 34].map((w, i) => (
                  <rect class="vx-art-shrink" style={`--i:${i}`} x="30" y={18 + i * 17} width={w} height="11" rx="3" fill={i === 4 ? "var(--color-mark)" : "var(--color-mark-wash)"} stroke="var(--color-mark)" />
                ))}
                <text x="210" y="112" text-anchor="end" fill="var(--color-mark)" font-weight="700">a+b ≠ b+a</text>
                <text x="210" y="128" text-anchor="end" fill="var(--color-ink-muted)">shrunk 4 times</text>
              </g>
            )}
          </svg>
          <span class="vx-show-text">
            <strong>{c.title}</strong>
            <span>{c.text}</span>
          </span>
        </a>
      </li>
    ))
  }
</ul>
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <defs>
    <marker id="vx-art-head" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" fill="var(--color-mark)" />
    </marker>
  </defs>
</svg>
